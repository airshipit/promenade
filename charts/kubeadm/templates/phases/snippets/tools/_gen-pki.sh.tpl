#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------------------
# Defaults & Usage
# ------------------------------------------------------------------------------
WORK_DIR="${WORK_DIR:-./secrets}"
CA_DAYS="${CA_DAYS:-3650}"
OUTPUT_FILE="${WORK_DIR}/values-pki.yaml"
INDENT="      "

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Generates Kubernetes & Etcd Root CAs and formats them into a values-pki.yaml snippet.

Options:
  -o, --out-file PATH    Path to output YAML (default: ${OUTPUT_FILE})
  -d, --days NUM         CA certificate validity in days (default: ${CA_DAYS})
  -h, --help             Show this help message
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--out-file) OUTPUT_FILE="$2"; shift 2 ;;
    -d|--days)     CA_DAYS="$2"; shift 2 ;;
    -h|--help)     usage ;;
    *) echo "Unknown option: $1" >&2; usage ;;
  esac
done

# ------------------------------------------------------------------------------
# Prerequisites Validation
# ------------------------------------------------------------------------------
for tool in openssl sed mktemp; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Error: Required utility '$tool' is not installed." >&2
    exit 1
  fi
done

mkdir -p "$(dirname "${OUTPUT_FILE}")"
CA_DIR=$(mktemp -d)
trap 'rm -rf "${CA_DIR}"' EXIT

# ------------------------------------------------------------------------------
# PKI Generation Engine
# ------------------------------------------------------------------------------
# runs openssl quietly, shows its output if it fails
ossl() {
  local out
  if ! out=$(openssl "$@" 2>&1); then
    echo "Error: openssl $1 failed:" >&2
    echo "${out}" >&2
    exit 1
  fi
}

gen_ca() {
  local name="$1" cn="$2"
  local key="${CA_DIR}/${name}.key"
  local crt="${CA_DIR}/${name}.crt"
  local cnf="${CA_DIR}/${name}.cnf"

  # Portable OpenSSL Config (works across all OpenSSL 1.0.2 / 1.1.1 / 3.x)
  cat > "${cnf}" <<EOF
[ req ]
distinguished_name = req_distinguished_name
prompt = no
x509_extensions = v3_ca

[ req_distinguished_name ]
CN = ${cn}

[ v3_ca ]
basicConstraints = critical, CA:TRUE
keyUsage = critical, digitalSignature, keyEncipherment, keyCertSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
EOF

  ossl genrsa -out "${key}" 2048
  ossl req -x509 -new -nodes -sha256 \
    -key "${key}" \
    -days "${CA_DAYS}" \
    -config "${cnf}" \
    -out "${crt}"
}

gen_sa() {
  ossl genrsa -out "${CA_DIR}/sa.key" 2048
  ossl rsa -in "${CA_DIR}/sa.key" -pubout -out "${CA_DIR}/sa.pub"
}

indent_pem() {
  local file="$1"
  sed "s/^/${INDENT}/" "${CA_DIR}/${file}"
}

# ------------------------------------------------------------------------------
# Execution
# ------------------------------------------------------------------------------
echo "Generating Kubernetes PKI Infrastructure..."
gen_ca "ca" "kubernetes"
gen_ca "etcd_ca" "etcd-ca"
gen_ca "front_proxy_ca" "front-proxy-ca"
gen_sa

(
  umask 077
  cat > "${OUTPUT_FILE}" <<EOF
# Generated by gen-pki.sh on $(date -u +"%Y-%m-%dT%H:%M:%SZ")
certs:
  ca:
    crt: |
$(indent_pem ca.crt)
    key: |
$(indent_pem ca.key)
  etcd_ca:
    crt: |
$(indent_pem etcd_ca.crt)
    key: |
$(indent_pem etcd_ca.key)
  front_proxy_ca:
    crt: |
$(indent_pem front_proxy_ca.crt)
    key: |
$(indent_pem front_proxy_ca.key)
  sa:
    key: |
$(indent_pem sa.key)
    pub: |
$(indent_pem sa.pub)
EOF
)

echo "Successfully written PKI credentials to: ${OUTPUT_FILE}"
