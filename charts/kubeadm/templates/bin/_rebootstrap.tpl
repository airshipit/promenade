{{/*
  the rebootstrap script: puts the certificates of the values again on a node
  of an existing cluster, whether its API is alive or not (recovery from an
  expired CA, abrupt CA rotation). Like the bootstrap script it is delivered
  with the bootstrap Secrets (bootstrap.action: rebootstrap) and run on the
  node, phase by phase on all the nodes at once (see
  templates/phases/snippets/common/_phases.sh.tpl). The phases it has and
  their order are the ones of bootstrap.rebootstrap_phases, the default ones
  are:
    reconcile_guard   - the anchors of the node wait while the backups exist
                        (backup.dir, the lock), the
                        reconcile passes going on finish first
    backup            - the certificates of the node to a new backup in
                        backup.dir (templates/phases/_backup.tpl); with
                        "restore": the certificates from the last backup,
                        then the restart phases again; with "remove": all
                        the backups, they have the keys, the
                        procedure removes them when it is over (after the
                        values are in the cluster): the anchors go on
    certs_sync        - the certificates (as the bootstrap)
    kubeconfigs_sync  - the kubeconfigs (as the bootstrap)
    kubelet_sync_rc   - the certificates and the kubeconfig of kubelet, its
                        unit and configuration (as the bootstrap)
    kubeadm_certs     - only if named, the values have the CAs only: what
                        kubeadm generated from the CAs again. On the control
                        plane nodes kubeadm generates its certificates and
                        kubeconfigs, on the workers (once the control plane
                        runs with the new CAs) kubelet goes through the TLS
                        bootstrap (KUBEADM_TOKEN)
    kubeadm_cluster_info - only if named, on a control plane node: the CA
                        of the cluster-info ConfigMap (kubeadm creates it
                        only), extension-apiserver-authentication is removed
                        (the apiserver creates it with the new CAs)
    static_pods_stop  - the static pods of the control plane (crictl stopp),
                        kubelet starts them again
    kubelet_stop, cri_restart, kubelet_start - the restart
    annotate_applied_kubelet - the node with the configuration of kubelet it
                        runs with (as the bootstrap, not the kubeadm one: the
                        script doesn't apply it)
    restart_clients   - only if named, on a control plane node: the pods
                        of bootstrap.rebootstrap_restart_selectors are deleted
                        once kube-root-ca.crt of all the namespaces has the
                        new CA, they keep the CA and the service account
                        tokens of the old ones
    check_run         - the node checks (templates/phases/_checks.tpl)
  The certificates are pregenerated (the certs values) or, with the CAs only,
  generated by kubeadm: the orchestration selects the phases
  (overrides/reference/ssh-orchestration-ca.yaml: the CAs only). The CA guard
  isn't run: changing the CA is what the script is for.
*/}}
{{- $envAll := index . 0 -}}
{{- $k8sConfDict := index . 1 -}}
{{- $nodename := index . 2 -}}
{{- $fs := dict -}}

{{/* all the archives of the node in one, unpacked to /run/kubeadm/<archive> */}}
{{- range $archive := list "all" "ctrl" -}}
{{- range $k,$v := get (get $k8sConfDict "fs") $archive -}}
{{- $_ := set $fs (print $archive "/" $k) $v -}}
{{- end -}}
{{- end -}}
{{- if ne $nodename "" -}}
{{- range $archive := list "all-pernode" "ctrl-pernode" -}}
{{- range $k,$v := get (get (get $k8sConfDict "fs") $archive) $nodename -}}
{{- $_ := set $fs (print $archive "/" $k) $v -}}
{{- end -}}
{{- end -}}
{{- end -}}


{{/* the functions of the script: always linked, they win over the ones of
     templates/phases (templates/phases/snippets/common/_phases_link.tpl) */}}
{{- $symbols := dict -}}

{{- $_ := set $symbols "reconcile_in_flight" (dict "body" `
# the reconcile passes going on on the node: the reconcile processes neither
# done nor waiting for the rebootstrap (the files of the anchor are in the mount
# namespace of its pod)
reconcile_in_flight() {
  local pid
  for pid in $(pgrep -f "^/bin/bash ${RECONCILE_DIR}/bin/reconcile" || true); do
    [ -e "/proc/${pid}/root${RECONCILE_DIR}/done" ] ||
      [ -e "/proc/${pid}/root${RECONCILE_DIR}/rebootstrap-wait" ] ||
      echo "${pid}"
  done
}
`) -}}

{{- $_ := set $symbols "reconcile_guard" (dict "needs" (list "reconcile_in_flight")
"body" (include "__reconcile_guard" $envAll)
) -}}

{{- $_ := set $symbols "annotate_applied_kubelet" (dict "needs" (list "annotate_applied" "annotations" "kubelet_config_sha256")
"body" `
# the first pass of the reconcile doesn't apply the configuration of kubelet
# again (the one of the values, the bundle may leave it to kubeadm)
annotate_applied_kubelet() {
  if [ ! -f "${ROOTFS}/run/kubeadm/all/_kubelet/kubelet_config.yaml" ]; then
    echo "the values have no configuration of kubelet"
    return 0
  fi
  annotate_applied "${KUBELET_ANNOTATION}=$(kubelet_config_sha256)"
}
`) -}}

{{- define "__delete_pods" -}}
{{- $envAll := . -}}
# the pods of the selector, the API of the restarted control plane may be
# unavailable for a while
delete_pods() {
  local kubectl=(kubectl --kubeconfig "${ROOTFS}/etc/kubernetes/admin.conf")
  local delay
  for delay in 0 1 2 4 8; do
    sleep "${delay}"
    "${kubectl[@]}" delete pods --all-namespaces -l "$1" --grace-period=0 --force && return 0
  done
  return 1
}
{{- end -}}
{{- $_ := set $symbols "delete_pods" (dict
"body" (include "__delete_pods" $envAll)
) -}}

{{- define "__wait_root_ca" -}}
{{- $envAll := . -}}
# the new CA in kube-root-ca.crt of all the namespaces (the controller-manager
# publishes it): the pods started before it get the old one and keep it
wait_root_ca() {
  local kubectl=(kubectl --kubeconfig "${ROOTFS}/etc/kubernetes/admin.conf")
  local ca namespaces ns stale="" i
  ca=$(cat "${ROOTFS}/etc/kubernetes/pki/ca.crt") || return 1
  for i in $(seq 60); do
    if namespaces=$("${kubectl[@]}" get namespaces -o name) && [ -n "${namespaces}" ]; then
      stale=""
      for ns in ${namespaces}; do
        ns="${ns#namespace/}"
        [ "$("${kubectl[@]}" -n "${ns}" get configmap kube-root-ca.crt -o jsonpath='{.data.ca\.crt}')" = "${ca}" ] ||
          stale="${stale} ${ns}"
      done
      [ -n "${stale}" ] || return 0
    fi
    sleep 2
  done
  echo "kube-root-ca.crt without the new CA:${stale:- (no namespaces)}" >&2
  return 1
}
{{- end -}}
{{- $_ := set $symbols "wait_root_ca" (dict
"body" (include "__wait_root_ca" $envAll)
) -}}

{{- $_ := set $symbols "restart_clients" (dict "needs" (list "wait_root_ca" "delete_pods")
"body" (include "__restart_clients" $envAll)
) -}}

{{- define "__reconcile_guard" -}}
{{- $envAll := . -}}
# the anchors of the node mustn't put the certificates of the values in the
# cluster back: they wait while the backups exist (the lock). The passes going
# on finish first
reconcile_guard() {
  local script pids deadline
  # kubelet keeps the ConfigMap volumes up to date: the script a restarted
  # anchor runs
  for script in "${ROOTFS}"/var/lib/kubelet/pods/*/volumes/kubernetes.io~configmap/bin/reconcile; do
    [ -f "${script}" ] || continue
    if ! grep -q wait_rebootstrap "${script}"; then
      echo "the anchor of ${script} doesn't wait for the rebootstrap: deploy the chart with it first" >&2
      return 1
    fi
  done
  mkdir -p -m 0700 "${ROOTFS}{{ $envAll.Values.backup.dir }}"
  deadline=$((SECONDS + {{ $envAll.Values.bootstrap.rebootstrap_reconcile_timeout | int }}))
  while pids=$(reconcile_in_flight) && [ -n "${pids}" ]; do
    if [ "${SECONDS}" -ge "${deadline}" ]; then
      echo "the reconcile passes $(echo ${pids}) didn't finish in {{ $envAll.Values.bootstrap.rebootstrap_reconcile_timeout | int }}s, the lock {{ $envAll.Values.backup.dir }} is kept" >&2
      return 1
    fi
    echo "waiting for the reconcile passes $(echo ${pids})"
    sleep 10
  done
  echo "the reconcile is locked: {{ $envAll.Values.backup.dir }}"
}
{{- end -}}
{{- define "__restart_clients" -}}
{{- $envAll := . -}}
# the abrupt rotation: the pods keep the CA (kube-root-ca.crt) and the service
# account tokens they started with, they don't work anyway, their controllers
# start them again once the new CA is published
restart_clients() {
  wait_root_ca || return 1
{{- range $selector := $envAll.Values.bootstrap.rebootstrap_restart_selectors }}
  delete_pods {{ $selector | quote }}
{{- end }}
  return 0
}
{{- end -}}

