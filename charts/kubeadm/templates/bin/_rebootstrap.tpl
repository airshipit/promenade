set -euo pipefail

# rootfs path (used to run mock tests. must be "" in real life)
ROOTFS="${ROOTFS:-}"

# for heredoc and subst_node_env, compatible with reconcile, where all this is set on daemonsets
export NODE_ROLE="${NODE_ROLE:-master}"
export NODE_NAME="${NODE_NAME:-$(hostname -s)}"
export NODE_IP="${NODE_IP:-$(hostname -I 2>/dev/null | awk '{print $1}')}"

echo Called with $# args: $@

# this value will be non empty if script was generated for specific name (e.g. if there are some files in per-node)
expected_node_name="{{ $nodename }}"
if [ -n "$expected_node_name" ]; then
  [ "$NODE_NAME" != "$expected_node_name" ] && echo "WARNING: Config for $expected_node_name is getting applied to $NODE_NAME"
fi
# the files delivered by the chart, the reconcile script finds them there too
ensure_fs() {
  local teepath="" # for debug
  [ -n "${ROOTFS}" ] && teepath="${ROOTFS}/tmp/fs.{{ $envAll.Values.bootstrap.compress_fs }}"
  mkdir -p -m 0700 "${ROOTFS}/run/kubeadm"
{{ $archive := $fs | include "tar" -}}
{{- if eq $envAll.Values.bootstrap.compress_fs "tar" -}}
  base64 -d << 'EOF_ARCHIVE_DATA' | tee $teepath | tar -x -C "${ROOTFS}/run/kubeadm"
{{ else if eq $envAll.Values.bootstrap.compress_fs "tgz" -}}
  {{- $archive = (dict "content" $archive "calc_crc32" true ) | include "gzip" -}}
  base64 -d << 'EOF_ARCHIVE_DATA' | tee $teepath | tar -xz -C "${ROOTFS}/run/kubeadm"
{{ else -}}{{- fail (printf "Unsupported format %s" $envAll.Values.bootstrap.compress_fs ) -}}{{ end -}}
{{- $archive | b64enc }}
EOF_ARCHIVE_DATA
}
cleanup_fs() {
{{- $dirs := dict -}}
{{- range $path, $_ := $fs -}}
{{- $_ := set $dirs (index (splitList "/" $path) 0) true -}}
{{- end -}}
{{- range $dir, $_ := $dirs }}
  rm -rf "${ROOTFS}/run/kubeadm/{{ $dir }}" || true
{{- end }}
  echo "cleanup_fs is done"
}

{{/* adding shared bash functions */}}
{{ $sharedLibsContent }}
{{- if $envAll.Values.checks.bootstrap }}
{{ get $k8sConfDict.sharedLibs "checks" }}
{{- end }}
{{ tuple $envAll "templates/phases/snippets/common/_phases.sh.tpl" | include "kubeadm.bundle.template" }}
# end of common functions

{{/* the functions of the phases for the certificates (templates/phases/_fs.tpl,
     templates/phases/_certs.tpl,
     templates/phases/_kubelet.tpl,
     templates/phases/_kubeadm.tpl) */}}
{{ get $k8sConfDict.sharedLibs "fs_rebootstrap_lib" }}
{{ get $k8sConfDict.sharedLibs "certs_rebootstrap_lib" }}
{{ get $k8sConfDict.sharedLibs "kubelet_rebootstrap_lib" }}
{{ get $k8sConfDict.sharedLibs "kubeadm_rebootstrap_lib" }}

# the cluster as its admin (kubeadm-cluster-info, restart-clients) or as the
# node (annotate, workers have no admin.conf): the shared functions use kubectl
kubectl() {
  command kubectl --kubeconfig "${KUBECTL_KUBECONFIG:-${ROOTFS}/etc/kubernetes/admin.conf}" "$@"
}

BACKUP_DIR="${ROOTFS}"{{ $envAll.Values.bootstrap.rebootstrap_backup_dir | quote }}
RECONCILE_DIR={{ $envAll.Values.anchor.reconcile.host_dir | quote }}

# the reconcile passes going on on the node: the reconcile processes neither
# done nor waiting for the rebootstrap (the files of the anchor are in the mount
# namespace of its pod)
reconcile_in_flight() {
  local pid
  for pid in $(pgrep -f "^/bin/bash ${RECONCILE_DIR}/bin/reconcile" || true); do
    [ -e "/proc/${pid}/root${RECONCILE_DIR}/done" ] ||
      [ -e "/proc/${pid}/root${RECONCILE_DIR}/rebootstrap-wait" ] ||
      echo "${pid}"
  done
}

# the anchors of the node mustn't put the certificates of the values in the
# cluster back: they wait while the backups exist (the lock). The passes going
# on finish first
phase_reconcile_guard() {
  local script pids deadline
  # kubelet keeps the ConfigMap volumes up to date: the script a restarted
  # anchor runs
  for script in "${ROOTFS}"/var/lib/kubelet/pods/*/volumes/kubernetes.io~configmap/bin/reconcile; do
    [ -f "${script}" ] || continue
    if ! grep -q wait_rebootstrap "${script}"; then
      echo "the anchor of ${script} doesn't wait for the rebootstrap: deploy the chart with it first" >&2
      return 1
    fi
  done
  mkdir -p -m 0700 "${BACKUP_DIR}"
  deadline=$((SECONDS + {{ $envAll.Values.bootstrap.rebootstrap_reconcile_timeout | int }}))
  while pids=$(reconcile_in_flight) && [ -n "${pids}" ]; do
    if [ "${SECONDS}" -ge "${deadline}" ]; then
      echo "the reconcile passes $(echo ${pids}) didn't finish in {{ $envAll.Values.bootstrap.rebootstrap_reconcile_timeout | int }}s, the lock ${BACKUP_DIR} is kept" >&2
      return 1
    fi
    echo "waiting for the reconcile passes $(echo ${pids})"
    sleep 10
  done
  echo "the reconcile is locked: ${BACKUP_DIR}"
}

# the certificates and the kubeconfigs kubeadm generated from the old CAs, the
# client certificates of kubelet (it would take the current one): kubeadm
# generates them from the new CAs, as kubeadm init did
kubeadm_init_certs() {
  local file dir super_admin=false
  # kubeadm init generates it on the first control plane node only
  [ -f "${ROOTFS}/etc/kubernetes/super-admin.conf" ] && super_admin=true
  for file in $(kubeadm_generated_files); do
    rm -f "${ROOTFS}${file}"
  done
  rm -f "${ROOTFS}"/var/lib/kubelet/pki/kubelet-client-*.pem
  dir=$(mktemp -d)
  kubeadm_node_config > "${dir}/config.yaml"
  kubeadm init phase certs all --config "${dir}/config.yaml"
  kubeadm init phase kubeconfig admin --config "${dir}/config.yaml"
  kubeadm init phase kubeconfig controller-manager --config "${dir}/config.yaml"
  kubeadm init phase kubeconfig scheduler --config "${dir}/config.yaml"
  kubeadm init phase kubeconfig kubelet --config "${dir}/config.yaml"
  if [ "${super_admin}" == "true" ]; then
    kubeadm init phase kubeconfig super-admin --config "${dir}/config.yaml"
  fi
  rm -rf "${dir}"
  # kubelet goes through the control plane endpoint
  sync_kubelet_kubeconfig || true
}

# the client certificate of kubelet from the new CA: kubelet goes through the
# TLS bootstrap again with the bootstrap token, as on the join (not kubeadm
# join phase kubelet-start: it refuses the node which is still Ready), it
# writes kubelet.conf, then the certificate once the CSR is approved,
# checks.attempts times 2 seconds apart
kubelet_tls_bootstrap() {
  local conf="${ROOTFS}/etc/kubernetes/bootstrap-kubelet.conf" n=1
  : "${KUBEADM_TOKEN:?the bootstrap token of the cluster}"
  rm -f "${ROOTFS}/etc/kubernetes/kubelet.conf" "${ROOTFS}"/var/lib/kubelet/pki/kubelet-client-*.pem
  command kubectl config --kubeconfig "${conf}" set-cluster kubernetes \
    --server "https://{{ $envAll.Values.kubeconfig.controlPlaneEndpoint }}" \
    --certificate-authority "${ROOTFS}/etc/kubernetes/pki/kubelet-client-ca.pem" --embed-certs
  command kubectl config --kubeconfig "${conf}" set-credentials tls-bootstrap-token-user --token "${KUBEADM_TOKEN}"
  command kubectl config --kubeconfig "${conf}" set-context default --cluster kubernetes --user tls-bootstrap-token-user
  # kubectl writes it 0600
  command kubectl config --kubeconfig "${conf}" use-context default
  systemctl daemon-reload
  systemctl restart kubelet
  until [ -f "${ROOTFS}/etc/kubernetes/kubelet.conf" ] && [ -f "${ROOTFS}/var/lib/kubelet/pki/kubelet-client-current.pem" ]; do
    if [ "$n" -ge {{ $envAll.Values.checks.attempts | int }} ]; then
      echo "kubelet didn't go through the TLS bootstrap" >&2
      return 1
    fi
    n=$((n + 1))
    sleep 2
  done
  rm -f "${conf}"
}

# what kubeadm generated from the old CAs on the node, from the new ones
phase_kubeadm_certs() {
  if [ "${NODE_ROLE}" == "master" ]; then
    kubeadm_init_certs
  else
    kubelet_tls_bootstrap
  fi
}

# the cluster wide objects with the CAs: kubeadm creates cluster-info only (the
# CA of the token discovery of the joining nodes, server side apply keeps the
# signatures of the tokens), the apiserver creates
# extension-apiserver-authentication with its CAs again (the aggregated API
# servers trust it)
phase_kubeadm_cluster_info() {
  local kubeconfig
  if kubeconfig=$(kubectl -n kube-public get configmap cluster-info -o jsonpath='{.data.kubeconfig}'); then
    kubeconfig=$(echo "${kubeconfig}" | sed "s|^\( *certificate-authority-data:\).*|\1 $(base64 < "${ROOTFS}/etc/kubernetes/pki/ca.crt" | tr -d '\n')|")
    kubectl -n kube-public create configmap cluster-info --from-literal=kubeconfig="${kubeconfig}" \
      --dry-run=client -o yaml | kubectl apply --server-side --force-conflicts -f -
  fi
  kubectl -n kube-system delete configmap extension-apiserver-authentication --ignore-not-found
}

# every run makes a new backup (<timestamp>) of the certificates of the node,
# they have the keys: backup-remove removes all of them when the procedure is
# over
phase_backup() {
  local backup
  backup="${BACKUP_DIR}/$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p -m 0700 "${BACKUP_DIR}" "${backup}"
  cert_backup "${backup}"
  kubelet_backup "${backup}"
  kubeadm_backup "${backup}"
  echo "the certificates are backed up to ${backup}"
}

# from the last backup or REBOOTSTRAP_BACKUP (<timestamp>)
phase_restore() {
  local backup
  backup="${REBOOTSTRAP_BACKUP:-$(ls -1 "${BACKUP_DIR}" | tail -n 1)}"
  # it removes the files the backup doesn't have: not a wrong or empty name
  if [ -z "${backup}" ] || [ ! -d "${BACKUP_DIR}/${backup}" ]; then
    echo "no backup '${backup}' in ${BACKUP_DIR}" >&2
    return 1
  fi
  cert_restore "${BACKUP_DIR}/${backup}"
  kubelet_restore "${BACKUP_DIR}/${backup}"
  kubeadm_restore "${BACKUP_DIR}/${backup}"
  echo "the certificates are restored from ${BACKUP_DIR}/${backup}"
}

phase_backup_remove() {
  rm -rf "${BACKUP_DIR}"
  echo "the backups ${BACKUP_DIR} are removed"
}

phase_certs() {
  sync_certs
}

phase_kubeconfigs() {
  sync_kubeconfigs
}

phase_kubelet() {
  sync_kubelet || true
}

# the static pods of the control plane: kubelet starts them again with the new
# certificates, etcd of all the control plane nodes at once
phase_static_pods_stop() {
  local component pods pod
  if [ "${NODE_ROLE}" != "master" ]; then
    echo "not a control plane node"
    return 0
  fi
  for component in kube-apiserver kube-controller-manager kube-scheduler etcd; do
    # not in the for list: errexit doesn't see a failure there
    pods=$(crictl pods -q --namespace kube-system --label "component=${component}")
    for pod in ${pods}; do
      crictl stopp "${pod}"
    done
  done
}

phase_kubelet_stop() {
  systemctl stop kubelet
}

# TODO: the reference procedure restarts the runtime, find out why (its history)
phase_cri_restart() {
  restart_cri
}

# as the bootstrap
phase_kubelet_start() {
  systemctl daemon-reload
  systemctl enable kubelet
  systemctl restart kubelet
}

# the first pass of the reconcile doesn't apply the configuration of kubelet
# again (the one of the values, the bundle may leave it to kubeadm)
phase_annotate() {
  local KUBECTL_KUBECONFIG="${ROOTFS}/etc/kubernetes/kubelet.conf"
  if [ ! -f "${ROOTFS}/run/kubeadm/all/_kubelet/kubelet_config.yaml" ]; then
    echo "the values have no configuration of kubelet"
    return 0
  fi
  annotate_applied "${KUBELET_ANNOTATION}=$(kubelet_config_sha256)"
}

# the pods of the selector, the API of the restarted control plane may be
# unavailable for a while
delete_pods() {
  local delay
  for delay in 0 1 2 4 8; do
    sleep "${delay}"
    kubectl delete pods --all-namespaces -l "$1" --grace-period=0 --force && return 0
  done
  return 1
}

# the new CA in kube-root-ca.crt of all the namespaces (the controller-manager
# publishes it): the pods started before it get the old one and keep it
wait_root_ca() {
  local ca namespaces ns stale="" i
  ca=$(cat "${ROOTFS}/etc/kubernetes/pki/ca.crt") || return 1
  for i in $(seq 60); do
    if namespaces=$(kubectl get namespaces -o name) && [ -n "${namespaces}" ]; then
      stale=""
      for ns in ${namespaces}; do
        ns="${ns#namespace/}"
        [ "$(kubectl -n "${ns}" get configmap kube-root-ca.crt -o jsonpath='{.data.ca\.crt}')" = "${ca}" ] ||
          stale="${stale} ${ns}"
      done
      [ -n "${stale}" ] || return 0
    fi
    sleep 2
  done
  echo "kube-root-ca.crt without the new CA:${stale:- (no namespaces)}" >&2
  return 1
}

# the abrupt rotation: the pods keep the CA (kube-root-ca.crt) and the service
# account tokens they started with, they don't work anyway, their controllers
# start them again once the new CA is published
phase_restart_clients() {
  wait_root_ca || return 1
{{- range $selector := $envAll.Values.bootstrap.rebootstrap_restart_selectors }}
  delete_pods {{ $selector | quote }}
{{- end }}
  return 0
}

phase_checks() {
  run_checks check_api
}

PHASES=(
  reconcile-guard backup +restore certs kubeconfigs kubelet +kubeadm-certs
  static-pods-stop kubelet-stop cri-restart kubelet-start annotate
{{- if $envAll.Values.checks.bootstrap }}
  checks
{{- end }}
  +kubeadm-cluster-info +restart-clients +backup-remove
)

while [[ $# -gt 0 ]]; do
  if phases_arg "$@"; then
    shift $phases_shift
  else
    echo "Unknown option: $1" >&2
    exit 1
  fi
done
phases_check "${PHASES[@]}"

ensure_fs
run_phases "${PHASES[@]}"
cleanup_fs
