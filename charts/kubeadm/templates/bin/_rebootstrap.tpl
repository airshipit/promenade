{{/*
  the rebootstrap script: puts the certificates of the values again on a node
  of an existing cluster, whether its API is alive or not (recovery from an
  expired CA, abrupt CA rotation). Like the bootstrap script it is delivered
  with the bootstrap Secrets (bootstrap.action: rebootstrap) and run on the
  node, phase by phase on all the nodes at once (see
  templates/phases/snippets/common/_phases.sh.tpl):
    reconcile-guard   - the anchors of the node wait while the backups exist
                        (bootstrap.rebootstrap_backup_dir, the lock), the
                        reconcile passes going on finish first
    backup            - the certificates of the node to a new backup in
                        bootstrap.rebootstrap_backup_dir
    restore           - only with --phases: the certificates from the last
                        backup (or REBOOTSTRAP_BACKUP), then the restart phases
                        again
    backup-remove     - only with --phases: all the backups, they have the
                        keys, the procedure removes them when it is over (after
                        the values are in the cluster): the anchors go on
    certs             - the certificates (as the bootstrap)
    kubeconfigs       - the kubeconfigs (as the bootstrap)
    kubelet           - the certificates and the kubeconfig of kubelet, its
                        unit and configuration (as the bootstrap)
    kubeadm-certs     - only with --phases, the values have the CAs only: what
                        kubeadm generated from the CAs again. On the control
                        plane nodes kubeadm generates its certificates and
                        kubeconfigs, on the workers (once the control plane
                        runs with the new CAs) kubelet goes through the TLS
                        bootstrap (KUBEADM_TOKEN)
    kubeadm-cluster-info - only with --phases, on a control plane node: the CA
                        of the cluster-info ConfigMap (kubeadm creates it
                        only), extension-apiserver-authentication is removed
                        (the apiserver creates it with the new CAs)
    static-pods-stop  - the static pods of the control plane (crictl stopp),
                        kubelet starts them again
    kubelet-stop, cri-restart, kubelet-start - the restart
    annotate          - the node with the configuration of kubelet it runs with
                        (as the bootstrap, not the kubeadm one: the script
                        doesn't apply it)
    restart-clients   - only with --phases, on a control plane node: the pods
                        of bootstrap.rebootstrap_restart_selectors are deleted
                        once kube-root-ca.crt of all the namespaces has the
                        new CA, they keep the CA and the service account
                        tokens of the old ones
    checks            - checks.bootstrap
  The certificates are pregenerated (the certs values) or, with the CAs only,
  generated by kubeadm: the orchestration selects the phases
  (overrides/reference/ssh-orchestration-ca.yaml: the CAs only). The CA guard
  isn't run: changing the CA is what the script is for.
*/}}
{{- $envAll := index . 0 -}}
{{- $k8sConfDict := index . 1 -}}
{{- $nodename := index . 2 -}}
{{- $fs := dict -}}

{{/* all the archives of the node in one, unpacked to /run/kubeadm/<archive> */}}
{{- range $archive := list "all" "ctrl" -}}
{{- range $k,$v := get $k8sConfDict.fs $archive -}}
{{- $_ := set $fs (print $archive "/" $k) $v -}}
{{- end -}}
{{- end -}}
{{- if ne $nodename "" -}}
{{- range $archive := list "all-pernode" "ctrl-pernode" -}}
{{- range $k,$v := get (get $k8sConfDict.fs $archive) $nodename -}}
{{- $_ := set $fs (print $archive "/" $k) $v -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- $sharedLibsContent :=  get $k8sConfDict "sharedLibsContent" -}}

